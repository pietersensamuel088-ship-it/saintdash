# ==============================================================================
# SaintDash - Environment Configuration Template
# Copy this file to .env and adjust the values for your Proxmox & Docker host.
# ==============================================================================

# --- Dashboard Security ---
# Secret key used for signing JWT authentication tokens (change to a random string)
JWT_SECRET=change-me-to-a-very-secure-random-token-minimum-32-chars
# Master password required to access your dashboard
DASHBOARD_PASSWORD=saintdash-admin-pass
# Session expiration in hours
JWT_EXPIRE_HOURS=72

# --- Proxmox VE Server API Settings ---
# URL to your Proxmox VE server (e.g., https://192.168.1.100:8006 or https://pve.lan:8006)
PROXMOX_HOST=https://192.168.1.100:8006
# Proxmox User with realm (e.g. root@pam or monitoring@pve)
PROXMOX_USER=root@pam
# API Token ID (created under Datacenter -> Permissions -> API Tokens)
PROXMOX_TOKEN_NAME=saintdash
# API Token Secret UUID (e.g. e848c263-d1f8-4e12-8bb4-080cb7a885bc)
PROXMOX_TOKEN_VALUE=your-token-uuid-here
# Set to false if Proxmox uses self-signed SSL certificates
PROXMOX_VERIFY_SSL=false

# --- Docker Monitoring Settings ---
# Docker socket path (default: unix:///var/run/docker.sock on Linux, or npipe:////./pipe/docker_engine on Windows)
DOCKER_HOST_SOCKET=unix:///var/run/docker.sock
# Enable Docker container inspection
DOCKER_ENABLED=true

# --- Database & Node Monitoring (Optional: Supabase / PostgreSQL) ---
# Connection string for your database node (leave blank if not using)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# Supabase project URL (optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Server Runtime ---
PORT=8000
HOST=0.0.0.0
# Set to 'true' to simulate sample data when Proxmox is unreachable
DEMO_MODE=false
